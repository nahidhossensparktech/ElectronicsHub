{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/tasks_hook.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
